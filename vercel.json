{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/login",
      "dest": "/api/login.js"
    },
    {
      "src": "/api/auth/me",
      "dest": "/api/auth-me.js"
    },
    {
      "src": "/api/tasks/daily",
      "dest": "/api/tasks-daily.js"
    },
    {
      "src": "/api/completions",
      "dest": "/api/completions.js"
    },
    {
      "src": "/api/inspiration/random",
      "dest": "/api/inspiration.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "env": {
    "JWT_SECRET": "your-secure-secret-key-change-this"
  }
}
